8","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"2a7a7e0ed8104e6e00f4438d0a7b57c4f8241dc82667d2f11719f3d444732c12","chunks":11,"words":1043,"party_signal":0.0033374368213117123,"social_signal":0.3717147409915924,"party_welcome":0.9839824438095093,"social_amenities":0.3717147409915924,"party_restriction":0.1277250051498413,"nearby_nightlife":0.9799647331237793,"signal_evidence":[{"text":"This spacious urban retreat features 4 bedrooms and 3.5 bathrooms, offering plenty of room for 2\u20133 families to relax and enjoy quality time together without sacrificing privacy. With stylish interiors, a full kitchen, private parking for 3 vehicles, and a cozy front porch perfect for coffee or conversation, this home is a favorite for multigenerational families, reunion trips, and city explorers. \ud83d\udecf\ufe0f Highlight of Space & Sleeping Arrangements: Room for Everyone Say goodbye to cramped hotel rooms\u2014this home comfortably sleeps your group with room to spare: Bedroom 1 (Downstairs): Queen bed Bedroom 2: King bed Bedroom 3: Queen bed","section":"FULL DESCRIPTION","line":52,"scores":{"party_welcome":0.0033374368213117123,"social_amenities":0.3717147409915924,"party_restriction":0.0024664681404829025,"nearby_nightlife":0.0023064075503498316},"affirmative_event_evidence":"With stylish interiors, a full kitchen, private parking for 3 vehicles, and a cozy front porch perfect for coffee or conversation, this home is a favorite for multigenerational families, reunion trips, and city explorers."}],"social_evidence":[{"text":"This spacious urban retreat features 4 bedrooms and 3.5 bathrooms, offering plenty of room for 2\u20133 families to relax and enjoy quality time together without sacrificing privacy. With stylish interiors, a full kitchen, private parking for 3 vehicles, and a cozy front porch perfect for coffee or conversation, this home is a favorite for multigenerational families, reunion trips, and city explorers. \