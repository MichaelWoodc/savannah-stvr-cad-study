}}]}}},{"listing_id":"1071964847793730841","title":"Gordon Street Suites: Garden Suite C","url":"https://www.airbnb.com/rooms/1071964847793730841","guests":2.0,"permits":["SVR-01985"],"analysis":{"listing_id":"1071964847793730841","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"209edde3f2484a1e8e454955d2dc779cfb9d1d3996c4500f6ac5dd0643d9de70","chunks":7,"words":677,"party_signal":0,"social_signal":0.8816233277320862,"party_welcome":0.0037123251240700483,"social_amenities":0.8816233277320862,"party_restriction":0.017518147826194763,"nearby_nightlife":0.2908397912979126,"signal_evidence":[],"social_evidence":[{"text":"Plates, bowls, cups, cutlery, and other utensils Freezer Dishwasher Stove Oven Hot water kettle Coffee maker: drip coffee maker Wine glasses Toaster Baking sheet Blender Dining table Coffee Location features Private entrance Separate street or building entrance Outdoor Private patio or balcony Backyard An open space on the property usually covered in grass Outdoor furniture Outdoor dining area Parking and facilities Paid parking off premises Single level home No stairs in home Services Self check-in Smart lock Not included Unavailable: Carbon monoxide alarm Carbon monoxide alarm There is no carbon monoxide detector on the property.","section":"AMENITIES","line":113,"scores":{"party_welcome":0.0002003405970754102,"social_amenities":0.8816233277320862,"party_restriction":0.00044821880874224007,"nearby_nightlife":0.001330663450062275}},{"text":"Fully renovated ground floor apartment in an historic 1854 townhouse overlooking Chatham Square. This prime location is just one block from Forsyth Park and walkable to a variety of museums, restaurants and shopping. The space This stunning fully renovated garden/ground level suite in an historic 1854 townhome overlooking charming Chatham Square. This prime location is just one block from Forsyth Park and the neighborhood contains some of the city\u2019s best row houses. It\u2019s a short walk from a variety of museums and historic sites, as well as restaurants, grocery stores, and shops. Living room is open & spacious with comfy seating & a dining table.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.0012312140315771103,"social_amenities":0.319050669670105,"party_restriction":0.009584199637174606,"nearby_nightlife":0.2908397912979126}}],"evidence":{"party_welcome":[{"text":"The newly renovated kitchen features stainless steel appliances and granite countertops. It is fully equipped and ready to whip up a meal or store great take out. The bedroom has queen bed and en suite bathroom with large, walk-in shower. Off the bedroom is the private patio with seating for you & the shared courtyard is for all guests in the building. Gather for meals in the dining room and admire the Razzia Louis Vuitton posters and the original brick floors and walls. This striking 1854 townhome mixes timeless furnishings with rich patterns and accents for a robust atmosphere with hints of eclecticism.","section":"FULL DESCRIPTION","line":44,"scores":{"party_welcome":0.0037123251240700483,"social_amenities":0.047780077904462814,"party_restriction":0.0005177450948394835,"nearby_nightlife":0.02309958077967167}},{"text":"Fully renovated ground floor apartment in an historic 1854 townhouse overlooking Chatham Square. This prime location is just one block from Forsyth Park and walkable to a variety of museums, restaurants and shopping. The space This stunning fully renovated garden/ground level suite in an historic 1854 townhome overlooking charming Chatham Square. This prime location is just one block from Forsyth Park and the neighborhood contains some of the city\u2019s best row houses. It\u2019s a short walk from a variety of museums and historic sites, as well as restaurants, grocery stores, and shops. Living room is open & spacious with comfy seating & a dining table.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.