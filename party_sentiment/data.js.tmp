255098","date":"2024-08-30","type":"22 FOUND PROPERTY","outcome":"Other","recorded_address":"413 E Hall St","recorded_pin":"20044 08026","side":"neighbors"},{"number":"26182188205","date":"2026-07-01","type":"67 WARRANT SERVICE","outcome":"Other","recorded_address":"711 PRICE ST","recorded_pin":"20044 08031","side":"neighbors"}],"listings":[{"listing_id":"40402108","title":"Saltwater Pool, Outdoor Fireplace & Garage!","url":"https://www.airbnb.com/rooms/40402108","guests":4.0,"permits":["SVR-02109"],"analysis":{"listing_id":"40402108","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"c29a9228854e52b82fa926dd233f8a9e0cb79f5a7dceec47d905bd2956f2ea1f","chunks":14,"words":1454,"party_signal":0,"social_signal":0.9638224840164185,"party_welcome":0.9915924072265625,"social_amenities":0.9638224840164185,"party_restriction":0.0028875332791358232,"nearby_nightlife":0.9978716373443604,"signal_evidence":[],"social_evidence":[{"text":"The full kitchen includes a breakfast bar with seating for two while the immediately adjacent dining space has a table for two as well. Full-size and modern appliances in the kitchen help make your stay easier as you can plan meals to eat at home. The bedroom includes a king bed, and there is a sofa bed in the living room. Like many of our Savannah vacation rentals, this property also offers a washer and dryer to make a longer stay even more convenient. Some other available amenities here include free wireless internet, a flat-screen TV in the living room, an outdoor fireplace, outdoor seating and a gas grill.","section":"FULL DESCRIPTION","line":57,"scores":{"party_welcome":0.0002900789841078222,"social_amenities":0.9638224840164185,"party_restriction":0.0006791888154111803,"nearby_nightlife":0.023745615035295486}},{"text":"Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Barbecue utensils Grill, charcoal, bamboo skewers/iron skewers, etc. Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Backyard An open space on the property usually covered in grass Fire pit Outdoor furniture BBQ grill Parking and facilities Free parking on premises Pool Services Pets allowed Assistance animals are always allowed Long term stays allowed Allow stay for 28 days or more Self check-in Keypad Check yourself into the home with a door code","section":"AMENITIES","line":232,"scores":{"party_welcome":0.0008817057241685688,"social_amenities":0.8420916795730591,"party_restriction":0.001765405759215355,"nearby_nightlife":0.0008016240317374468}}],"evidence":{"party_welcome":[{"text":"Offstreet parking for 1 car in garage Please note the pool and courtyard are shared with the 4 BR main house. The main and carriage houses are available to rent together for larger parties. See the Southern Elegance Estate property page for rates and more details. Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on Tybee Island. For our Savannah properties it is a scenic 25-minute drive through Wilmington and Whitmarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times.","section":"FULL DESCRIPTION","line":142,"scores":{"party_welcome":0.9915924072265625,"social_amenities":0.20536580681800842,"party_restriction":0.0006537828594446182,"nearby_nightlife":0.014765562489628792}},{"text":"You can hop on and off at any of the trolley's 15 stops in order to explore more. Another trolley will be along in about 20 minutes. Easily within reach of most of our Savannah vacation rentals, the City Market is another must-see destination. The market covers four blocks and is filled with open-air shopping stops, restaurants and restored warehouses. Concerts are often held here as well. City Market is known as Savannah's nightlife stop, so you may want to visit earlier in the day if you have kids with you. Art and history buffs in your party will enjoy a visit to the Telfair Art Museum.","section":"FULL DESCRIPTION","line":65,"scores":{"party_welcome":0.9294523000717163,"social_amenities":0.0004136964853387326,"party_restriction":0.000443675002316013,"nearby_nightlife":0.9978716373443604}}],"social_amenities":[{"text":"The full kitchen includes a breakfast bar with seating for two while the immediately adjacent dining space has a table for two as well. Full-size and modern appliances in the kitchen help make your stay easier as you can plan meals to eat at home. The bedroom includes a king bed, and there is a sofa bed in the living room. Like many of our Savannah vacation rentals, this property also offers a washer and dryer to make a longer stay even more convenient. Some other available amenities here include free wireless internet, a flat-screen TV in the living room, an outdoor fireplace, outdoor seating and a gas grill.","section":"FULL DESCRIPTION","line":57,"scores":{"party_welcome":0.0002900789841078222,"social_amenities":0.9638224840164185,"party_restriction":0.0006791888154111803,"nearby_nightlife":0.023745615035295486}},{"text":"Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Barbecue utensils Grill, charcoal, bamboo skewers/iron skewers, etc. Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Backyard An open space on the property usually covered in grass Fire pit Outdoor furniture BBQ grill Parking and facilities Free parking on premises Pool Services Pets allowed Assistance animals are always allowed Long term stays allowed Allow stay for 28 days or more Self check-in Keypad Check yourself into the home with a door code","section":"AMENITIES","line":232,"scores":{"party_welcome":0.0008817057241685688,"social_amenities":0.8420916795730591,"party_restriction":0.001765405759215355,"nearby_nightlife":0.0008016240317374468}}],"party_restriction":[{"text":"You will immediately understand why it's considered the most impressive building in the city. Your stay in Savannah vacation homes might also give you the opportunity to enjoy a special event or two, depending on when you come. The Savannah area hosts many different festivals and celebrations throughout the year. The following list is an example of what you might find: \u2022 Annual Martin Luther King, Jr. Day Celebration in January \u2022 Savannah Black Heritage Festival in February \u2022 Saint Patrick's Day in Savannah in March \u2022 Savannah Tour of Homes and Gardens in March \u2022 Savannah Garden Expo in April \u2022 SCAD Sand Arts Festival on Tybee in May","section":"FULL DESCRIPTION","line":77,"scores":{"party_welcome":0.11341635137796402,"social_amenities":0.008919380605220795,"party_restriction":0.0028875332791358232,"nearby_nightlife":0.6397366523742676}},{"text":"March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm Additional Pool Hours available during the off-season are listed below. If these dates fall in the middle of the week, the pool will be open as listed below and every Friday and Saturday. Day before Thanksgiving, Thanksgiving Day, and the day after Thanksgiving Day before Christmas Eve, Christmas Eve & Day, and the day after Christmas Day Day before New Years Day, New Years Day, and the day after New Years Day Day before MLK Day, MLK Day, and the day after MLK Day Guests with Pets","section":"FULL DESCRIPTION","line":155,"scores":{"party_welcome":0.1414889097213745,"social_amenities":0.010131721384823322,"party_restriction":0.0018146364018321037,"nearby_nightlife":0.010140525177121162}}],"nearby_nightlife":[{"text":"You can hop on and off at any of the trolley's 15 stops in order to explore more. Another trolley will be along in about 20 minutes. Easily within reach of most of our Savannah vacation rentals, the City Market is another must-see destination. The market covers four blocks and is filled with open-air shopping stops, restaurants and restored warehouses. Concerts are often held here as well. City Market is known as Savannah's nightlife stop, so you may want to visit earlier in the day if you have kids with you. Art and history buffs in your party will enjoy a visit to the Telfair Art Museum.","section":"FULL DESCRIPTION","line":65,"scores":{"party_welcome":0.9294523000717163,"social_amenities":0.0004136964853387326,"party_restriction":0.000443675002316013,"nearby_nightlife":0.9978716373443604}},{"text":"\u2022 Fourth of July Fireworks on the River in July \u2022 Seafood & Music Festival in August \u2022 Savannah Film Festival in September \u2022 Tybee Pirate Fest in October \u2022 Savannah Harbor Boat Parade of Lights in November \u2022 Tybee Island New Year's Eve Fireworks in December SVR-02109 Guest access Saltwater pool Beautiful courtyard with outdoor seating Gas grill Outdoor fireplace Full kitchen Dining table with seating for 2 Breakfast bar with seating for 2 Flatscreen TV in Living room Free wifi Bedroom 1: King bed, flatscreen TV, en suite bathroom Sofa bed in living room Full bathroom has walk in shower Washer/dryer in unit Drip coffee maker","section":"FULL DESCRIPTION","line":97,"scores":{"party_welcome":0.6501449346542358,"social_amenities":0.2890515923500061,"party_restriction":0.00038593722274526954,"nearby_nightlife":0.9822928309440613}}]}}},{"listing_id":"40402109","title":"Stately Savannah Home w/ Saltwater Pool","url":"https://www.airbnb.com/rooms/40402109","guests":8.0,"permits":["SVR-02108"],"analysis":{"listing_id":"40402109","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"2986bfa4cc1756aedb556fff743db86aa39702f81617f42b3931c1c1ebdb6858","chunks":16,"words":1576,"party_signal":0,"social_signal":0.4884433448314667,"party_welcome":0.96004319190979,"social_amenities":0.4884433448314667,"party_restriction":0.002244580304250121,"nearby_nightlife":0.978659451007843,"signal_evidence":[],"social_evidence":[{"text":"See the Southern Elegance Estate property page for rates and more details. Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on Tybee Island. For our Savannah properties it is a scenic 25-minute drive through Wilmington and Whitmarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm Additional Pool Hours available during the off-season are listed below.","section":"FULL DESCRIPTION","line":176,"scores":{"party_welcome":0.0001534334587631747,"social_amenities":0.4884433448314667,"party_restriction":0.0007681373972445726,"nearby_nightlife":0.0010859299218282104}},{"text":"Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Backyard An open space on the property usually covered in grass Fire pit Outdoor furniture Parking and facilities Free parking on premises Free street parking Pool Services Pets allowed Assistance animals are always allowed Long term stays allowed Allow stay for 28 days or more Self check-in Keypad Check yourself into the home with a door code","section":"AMENITIES","line":272,"scores":{"party_welcome":0.0009686171542853117,"social_amenities":0.17442888021469116,"party_restriction":0.001650297432206571,"nearby_nightlife":0.0006353356293402612}}],"evidence":{"party_welcome":[{"text":"You can generally explore the island in a day with the Tybee Lighthouse and Marine Science Center being the most popular attractions. There are other activities as well, including water sports, bike rentals, marsh treks and dolphin-watching charters. During your stay in our Savannah vacation homes, you may have the opportunity to check out a special event or two. Several events and festivals take place in Savannah and on nearby Tybee Island over the year. Take a look at some of the following possibilities: \u2022 Martin Luther King Day Parade in January \u2022 Mardi Gras Tybee in February \u2022 Saint Patrick's Day in Savannah in March","section":"FULL DESCRIPTION","line":93,"scores":{"party_welcome":0.96004319190979,"social_amenities":0.004624403081834316,"party_restriction":0.0009851824725046754,"nearby_nightlife":0.978659451007843}},{"text":"\u2022 First Saturday on the River festival from March to December \u2022 Earth Day Celebration in April \u2022 SCAD Sand Arts Festival on Tybee in May \u2022 Fourth of July Fireworks on the River in July \u2022 Tybee Pirate Fest in October \u2022 Oktoberfest on the River in October \u2022 Southern Lights Holiday Celebration in November \u2022 Tybee Island Christmas Parade in December \u2022 Holiday Tour of Homes in December \u2022 Tybee Island New Year's Eve Fireworks in December We have the best selection of Savannah vacation rentals in the city, whether you need something small, large or anything in between! SVR-02108 Guest access Saltwater pool","section":"FULL DESCRIPTION","line":107,"scores":{"party_welcome":0.09990046173334122,"social_amenities":0.00032547584851272404,"party_restriction":0.0004431428387761116,"nearby_nightlife":0.9071537852287292}}],"social_amenities":[{"text":"See the Southern Elegance Estate property page for rates and more details. Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on Tybee Island. For our Savannah properties it is a scenic 25-minute drive through Wilmington and Whitmarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm Additional Pool Hours available during the off-season are listed below.","section":"FULL DESCRIPTION","line":176,"scores":{"party_welcome":0.0001534334587631747,"social_amenities":0.4884433448314667,"party_restriction":0.0007681373972445726,"nearby_nightlife":0.0010859299218282104}},{"text":"Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Backyard An open space on the property usually covered in grass Fire pit Outdoor furniture Parking and facilities Free parking on premises Free street parking Pool Services Pets allowed Assistance animals are always allowed Long term stays allowed Allow stay for 28 days or more Self check-in Keypad Check yourself into the home with a door code","section":"AMENITIES","line":272,"scores":{"party_welcome":0.0009686171542853117,"social_amenities":0.17442888021469116,"party_restriction":0.001650297432206571,"nearby_nightlife":0.0006353356293402612}}],"party_restriction":[{"text":"When you stay in Savannah vacation rentals, you can easily do more than walk around Savannah. For example, the relaxing Atlantic beaches of Tybee Island are only 30 minutes away by car. Tybee Island is one of the top extra excursions for guests of our Savannah vacation homes. It's easy to see why the moment you arrive. Tybee Island is a cozy barrier island to the east of Savannah. It includes a long stretch of beach on the Atlantic Ocean as well as beaches at the Savannah River mouth and the banks on the west.","section":"FULL DESCRIPTION","line":93,"scores":{"party_welcome":0.00015039478603284806,"social_amenities":0.01349799707531929,"party_restriction":0.002244580304250121,"nearby_nightlife":0.10261482000350952}},{"text":"City of Savannah Code of Ordinances, Division II, Part 8, Chapter 3 (Zoning), Article 8.0, Section 8.4.37(b) \u2013 Short-Term Vacation Rental Use Standards: Occupants shall not exceed four adults for dwelling units with no more than two bedrooms. For dwelling units with three or more bedrooms, the number shall not exceed two adults per bedroom. SVR-02108 Show more","section":"FULL DESCRIPTION","line":219,"scores":{"party_welcome":6.503325130324811e-05,"social_amenities":0.0016529140993952751,"party_restriction":0.00197625532746315,"nearby_nightlife":0.0006673876196146011}}],"nearby_nightlife":[{"text":"You can generally explore the island in a day with the Tybee Lighthouse and Marine Science Center being the most popular attractions. There are other activities as well, including water sports, bike rentals, marsh treks and dolphin-watching charters. During your stay in our Savannah vacation homes, you may have the opportunity to check out a special event or two. Several events and festivals take place in Savannah and on nearby Tybee Island over the year. Take a look at some of the following possibilities: \u2022 Martin Luther King Day Parade in January \u2022 Mardi Gras Tybee in February \u2022 Saint Patrick's Day in Savannah in March","section":"FULL DESCRIPTION","line":93,"scores":{"party_welcome":0.96004319190979,"social_amenities":0.004624403081834316,"party_restriction":0.0009851824725046754,"nearby_nightlife":0.978659451007843}},{"text":"The second bath includes a tub with shower. The third floor is its own suite \u2013 including a king-sized bed, living area, wet bar, and full bath. Southern Elegance is steps away from one of Savannah\u2019s best-rated coffee shops and bakeries and a short walk to the grocery store for all your last-minute needs. Parking: Southern Elegance includes a garage. There is also usually plenty of parking available right in front of the house. Historic Charm: The house was built in 1892 for Frederick Wessells and maintains that Savannah historic charm, while providing you with space for everyone and modern d\u00e9cor and amenities you\u2019ll cherish during your stay.","section":"FULL DESCRIPTION","line":47,"scores":{"party_welcome":0.0003132850397378206,"social_amenities":0.0007881720084697008,"party_restriction":0.00043924187775701284,"nearby_nightlife":0.9153006672859192}}]}}},{"listing_id":"40402111","title":"Large Home Near Forsyth Park w/ Private Pool!","url":"https://www.airbnb.com/rooms/40402111","guests":12.0,"permits":["SVR-02108","SVR-02109"],"analysis":{"listing_id":"40402111","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"c0251fc838577bc439ddb97406428fb87be7b8ffa744463976b8f9e1b4152a1e","chunks":14,"words":1381,"party_signal":0,"social_signal":0.7801691889762878,"party_welcome":0.0018294451292604208,"social_amenities":0.7801691889762878,"party_restriction":0.020301291719079018,"nearby_nightlife":0.8809664845466614,"signal_evidence":[],"social_evidence":[{"text":"For our Savannah properties it is a scenic 25-minute drive through Wilmington and Whitmarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm Additional Pool Hours available during the off-season are listed below. If these dates fall in the middle of the week, the pool will be open as listed below and every Friday and Saturday. Day before Thanksgiving, Thanksgiving Day, and the day after Thanksgiving","section":"FULL DESCRIPTION","line":145,"scores":{"party_welcome":0.0018294451292604208,"social_amenities":0.7801691889762878,"party_restriction":0.020301291719079018,"nearby_nightlife":0.004068357869982719}},{"text":"Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Backyard An open space on the property usually covered in grass Fire pit Outdoor furniture Parking and facilities Free parking on premises Free street parking Pool Services Pets allowed Assistance 