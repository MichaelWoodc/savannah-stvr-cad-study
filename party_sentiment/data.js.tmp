aints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[],"listings":[{"listing_id":"978268371565998122","title":"Spacious Historic 2BD 2BA Downtown Condo","url":"https://www.airbnb.com/rooms/978268371565998122","guests":4.0,"permits":["SVR-02829"],"analysis":null}],"complete":false},{"pin":"20016 15032","address":"310 W BROUGHTON ST #3002","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":4,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[],"listings":[{"listing_id":"30767664","title":"Heated Pool Access | Broughton Street Rental","url":"https://www.airbnb.com/rooms/30767664","guests":4.0,"permits":["SVR-03263"],"analysis":{"listing_id":"30767664","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"f6c851fa629cac6424d84b558e85caae904512a594ee2b6cd58a985d468b247d","chunks":15,"words":1400,"party_signal":0,"social_signal":0.044132161885499954,"party_welcome":0.022319531068205833,"social_amenities":0.044132161885499954,"party_restriction":0.0043966397643089294,"nearby_nightlife":0.9914606809616089,"signal_evidence":[],"social_evidence":[{"text":"Gourmet, Modern Kitchen Open Floor Plan In the Middle of the Downtown Action Drip Coffee Maker Washer/dryer in unit Elevator in building Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on the South End of Tybee Island. For our Savannah properties, it is a scenic 25-minute drive through Wilmington and Whitemarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm","section":"FULL DESCRIPTION","line":103,"scores":{"party_welcome":0.000671562273055315,"social_amenities":0.044132161885499954,"party_restriction":0.002377553842961788,"nearby_nightlife":0.019660143181681633}},{"text":"Additional Pool Hours available during the off-season are listed below. If these dates fall in the middle of the week, the pool will be open as listed below and every Friday and Saturday. Day before Thanksgiving, Thanksgiving Day, and the day after Thanksgiving Day before Christmas Eve, Christmas Eve & Day, and the day after Christmas Day Day before New Years Day, New Years Day, and the day after New Years Day Day before MLK Day, MLK Day, and the day after MLK Day Summer Hours of the North End Pool - Unheated Open daily from 10:00 a.m.\u20135:00 p.m. May 31\u2013Tuesday after Labor Day Guests with Pets","section":"FULL DESCRIPTION","line":128,"scores":{"party_welcome":0.022319531068205833,"social_amenities":0.011430354788899422,"party_restriction":0.0011089398758485913,"nearby_nightlife":0.00928357895463705}}],"evidence":{"party_welcome":[{"text":"Additional Pool Hours available during the off-season are listed below. If these dates fall in the middle of the week, the pool will be open as listed below and every Friday and Saturday. Day before Thanksgiving, Thanksgiving Day, and the day after Thanksgiving Day before Christmas Eve, Christmas Eve & Day, and the day after Christmas Day Day before New Years Day, New Years Day, and the day after New Years Day Day before MLK Day, MLK Day, and the day after MLK Day Summer Hours of the North End Pool - Unheated Open daily from 10:00 a.m.\u20135:00 p.m. May 31\u2013Tuesday after Labor Day Guests with Pets","section":"FULL DESCRIPTION","line":128,"scores":{"party_welcome":0.022319531068205833,"social_amenities":0.011430354788899422,"party_restriction":0.0011089398758485913,"nearby_nightlife":0.00928357895463705}},{"text":"Stately brick warehouses converted to stores and galleries, cobble-paved streets and other remnants of bygone days make you feel as if you are stepping back in time while the river views and bustle keep you firmly rooted in the present. However, no matter what time of year you spend in Savannah vacation homes, there is so much to see and do in the hospitality center of the South that you will stay entertained from start to finish. Contact Southern Belle to reserve premium vacation rentals Savannah GA today. Guest access Parking included for 1 vehicle King bed Queen size sleeper sofa Flat screen TVs in living room and bedroom","section":"FULL DESCRIPTION","line":90,"scores":{"party_welcome":0.0009595370502211154,"social_amenities":0.00354361766949296,"party_restriction":0.0018556577851995826,"nearby_nightlife":0.06372527033090591}}],"social_amenities":[{"text":"Gourmet, Modern Kitchen Open Floor Plan In the Middle of the Downtown Action Drip Coffee Maker Washer/dryer in unit Elevator in building Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on the South End of Tybee Island. For our Savannah properties, it is a scenic 25-minute drive through Wilmington and Whitemarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm","section":"FULL DESCRIPTION","line":103,"scores":{"party_welcome":0.000671562273055315,"social_amenities":0.044132161885499954,"party_restriction":0.002377553842961788,"nearby_nightlife":0.019660143181681633}},{"text":"Above Broughton 3002 Located in a wonderful vintage neighborhood where night life, restaurants, boutiques and Savannah's top visitor destinations are just footsteps from your front door, Above Broughton 3002 is one of our best-addressed Savannah vacation rentals. Whether you are planning a weekend getaway or an extended stay, vacation rentals Savannah GA on Broughton Street put you at the center of the action. The space The Above Broughton Flat This part of town is famous for its eclectic shops, which range from fabulous antique and whatnot stores such as The Paris Market to unique vendors of locally sourced products like Savannah Bee.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.00024537931312806904,"social_amenities":0.01229744404554367,"party_restriction":0.0013403670163825154,"nearby_nightlife":0.9914606809616089}}],"party_restriction":[{"text":"This property is not pet-friendly. If you\u2019re traveling with a dog, ask us about our pet-friendly properties that accommodate up to 2 dogs (50 lb combined weight max) for a $130 pet fee. Long-Term Stays For our long-term stays, 30 days or more, we require a deposit and our office will reach out to you for details. For these reservations, we require an additional cleaning at a cost every 30 days. The cleaning cost varies by property. Our office will be in touch to schedule. Occupancy","section":"FULL DESCRIPTION","line":150,"scores":{"party_welcome":0.00016205816064029932,"social_amenities":0.004803201649338007,"party_restriction":0.0043966397643089294,"nearby_nightlife":0.0014630220830440521}},{"text":"Gourmet, Modern Kitchen Open Floor Plan In the Middle of the Downtown Action Drip Coffee Maker Washer/dryer in unit Elevator in building Other things to note Heated Pool Access Our guests have access to our beautiful, heated pool that is located on the South End of Tybee Island. For our Savannah properties, it is a scenic 25-minute drive through Wilmington and Whitemarsh Island, taking you over the Savannah River Delta onto Tybee Island. The Pool is open during the below dates and times. March 1 - Oct 31: Open 7 days a week from 10am-5pm. Nov 1 - Feb 28/29: Open Friday and Saturday from 10am-5pm","section":"FULL DESCRIPTION","line":103,"scores":{"party_welcome":0.000671562273055315,"social_amenities":0.044132161885499954,"party_restriction":0.002377553842961788,"nearby_nightlife":0.019660143181681633}}],"nearby_nightlife":[{"text":"Above Broughton 3002 Located in a wonderful vintage neighborhood where night life, restaurants, boutiques and Savannah's top visitor destinations are just footsteps from your front door, Above Broughton 3002 is one of our best-addressed Savannah vacation rentals. Whether you are planning a weekend getaway or an extended stay, vacation rentals Savannah GA on Broughton Street put you at the center of the action. The space The Above Broughton Flat This part of town is famous for its eclectic shops, which range from fabulous antique and whatnot stores such as The Paris Market to unique vendors of locally sourced products like Savannah Bee.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.00024537931312806904,"social_amenities":0.01229744404554367,"party_restriction":0.0013403670163825154,"nearby_nightlife":0.9914606809616089}},{"text":"You will wake up refreshed and eager to go out and explore the city. Check the weather report on the wall-mounted TV as you get ready. Easy Access to the Best of Savannah's Historic District Broughton Street accommodates pedestrian traffic, and several of the places you most want to visit during your Savannah vacation rentals stay are just a short walk away. A typical mix of the old and the new, the Broughton district is home to the Savannah College of Art and Design.","section":"FULL DESCRIPTION","line":66,"scores":{"party_welcome":0.00025333117810077965,"social_amenities":0.001998273655772209,"party_restriction":0.0019803771283477545,"nearby_nightlife":0.9906365275382996}}]}}}],"complete":true},{"pin":"20016 15034","address":"310 W BROUGHTON ST #3004","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":5.0,"neighbor_count":2,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[],"listings":[{"listing_id":"50909251","title":"The Georgia Peach -near Plant Riverside & downtown","url":"https://www.airbnb.com/rooms/50909251","guests":5.0,"permits":["SVR-02884"],"analysis":{"listing_id":"50909251","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"e2b4e6d58dcbf313d677f750d78f4b2679bf3fb02c910c7f75da7d9375c482e8","chunks":4,"words":356,"party_signal":0,"social_signal":0.007846425287425518,"party_welcome":0.00034159127972088754,"social_amenities":0.007846425287425518,"party_restriction":0.0015492875827476382,"nearby_nightlife":0.16321353614330292,"signal_evidence":[],"social_evidence":[{"text":"What this place offers Bathroom Hair dryer Shampoo Hot water Bedroom and laundry Washer Dryer Essentials Towels, bed sheets, soap, and toilet paper Extra pillows and blankets Entertainment TV Heating and cooling Air conditioning Heating Home safety Exterior security cameras on property We have a Ring security camera located above the front door. Internet and office Wifi Kitchen and dining Kitchen Space where guests can cook their own meals Cooking basics Pots and pans, oil, salt and pepper Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Dishwasher Coffee maker Parking and facilities Elevator","section":"AMENITIES","line":54,"scores":{"party_w