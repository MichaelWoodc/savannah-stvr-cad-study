de":"direct"},{"number":"25075073921","date":"2025-03-16","type":"1-4 PHYSICAL DISTURB.","outcome":"Other","recorded_address":"424 E President St","recorded_pin":"20005 23001","side":"direct"}],"listings":[{"listing_id":"1769656515223102111","title":"1810 Federalist Home | 2 Condos + Parking","url":"https://www.airbnb.com/rooms/1769656515223102111","guests":10.0,"permits":["SVR-02754"],"analysis":{"listing_id":"1769656515223102111","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"f5a83369dbf55e0ddc635b1a8d1daf66272e8d388d29011d0c1b355be9d8a53f","chunks":8,"words":693,"party_signal":0,"social_signal":0.41146498918533325,"party_welcome":0.9698008894920349,"social_amenities":0.41146498918533325,"party_restriction":0.002805905882269144,"nearby_nightlife":0.23830357193946838,"signal_evidence":[],"social_evidence":[{"text":"Exterior security camera located outside front entrances for guest safety and the security of the premises. Smoke alarm Carbon monoxide alarm Fire extinguisher First aid kit Internet and office Wifi Dedicated workspace Kitchen and dining Kitchen Space where guests can cook their own meals Refrigerator Microwave Cooking basics Pots and pans, oil, salt and pepper Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Barbecue utensils Grill, charcoal, bamboo skewers/iron skewers, etc. Dining table Coffee Location features Private entrance Separate street or building entrance Outdoor Outdoor dining area BBQ grill Parking and facilities","section":"AMENITIES","line":109,"scores":{"party_welcome":0.0004214800719637424,"social_amenities":0.41146498918533325,"party_restriction":0.0007466071983799338,"nearby_nightlife":0.0006922982283867896}},{"text":"Outside in the small garden, you'll find a little seating area and a propane grill, which offers opportunities for relaxation and al fresco dining. As you step inside, you'll be captivated by the seamless blend of original architecture and modern amenities. The first floor condo welcomes you with a spacious living room featuring a flat-screen TV, speedy fast WiFi, and ample seating. If you want some home cooked meals, a full kitchen and dining area awaits. Get some rest in the two king primary suites too! Upstairs, you will find another living room and another large galley style kitchen.","section":"FULL DESCRIPTION","line":56,"scores":{"party_welcome":0.00015084791812114418,"social_amenities":0.21728083491325378,"party_restriction":0.0004893666482530534,"nearby_nightlife":0.01562558114528656}}],"evidence":{"party_welcome":[{"text":"The adjacent dining room is a grand space, ideal for entertaining friends and family. And for the mornings where you need a quick bite before you're off to explore all that Savannah has to offer...there's a cozy breakfast area just off the kitchen! Step towards the back of the house and you'll find the large sunroom, filled with natural light and perfect for indulging in a good book with a cup of coffee. Our powder room is adorned with a gorgeous, hand painted, mural wallpaper by a local artist!","section":"FULL DESCRIPTION","line":60,"scores":{"party_welcome":0.9698008894920349,"social_amenities":0.0035015279427170753,"party_restriction":0.00039957405533641577,"nearby_nightlife":0.23830357193946838}},{"text":"This building is split into the large main parlor level house and a separate garden level condo (the small condo at street level). Both are part of this listing and connected via an internal staircase. Yes, you have two fully appointed living spaces! Other things to note Don't be afraid to reach out if you need anything! We live super close-by and are always happy to help out, even mid-stay. Show more","section":"FULL DESCRIPTION","line":67,"scores":{"party_welcome":0.0008544925367459655,"social_amenities":0.001073417253792286,"party_restriction":0.0004619056126102805,"nearby_nightlife":0.0011642393656075}}],"social_amenities":[{"text":"Exterior security camera located outside front entrances for guest safety and the security of the premises. Smoke alarm Carbon monoxide alarm Fire extinguisher First aid kit Internet and office Wifi Dedicated workspace Kitchen and dining Kitchen Space where guests can cook their own meals Refrigerator Microwave Cooking basics Pots and pans, oil, salt and pepper Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Freezer Dishwasher Stove Oven Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Barbecue utensils Grill, charcoal, bamboo skewers/iron skewers, etc. Dining table Coffee Location features Private entrance Separate street or building entrance Outdoor Outdoor dining area BBQ grill Parking and facilities","section":"AMENITIES","line":109,"scores":{"party_welcome":0.0004214800719637424,"social_amenities":0.41146498918533325,"party_restriction":0.0007466071983799338,"nearby_nightlife":0.0006922982283867896}},{"text":"Outside in the small garden, you'll find a little seating area and a propane grill, which offers opportunities for relaxation and al fresco dining. As you step inside, you'll be captivated by the seamless blend of original architecture and modern amenities. The first floor condo welcomes you with a spacious living room featuring a flat-screen TV, speedy fast WiFi, and ample seating. If you want some home cooked meals, a full kitchen and dining area awaits. Get some rest in the two king primary suites too! Upstairs, you will find another living room and another large galley style kitchen.","section":"FULL DESCRIPTION","line":56,"scores":{"party_welcome":0.00015084791812114418,"social_amenities":0.21728083491325378,"party_restriction":0.0004893666482530534,"nearby_nightlife":0.01562558114528656}}],"party_restriction":[{"text":"What this place offers Bathroom Hair dryer Shampoo Conditioner Body soap Hot water Bedroom and laundry Washer Dryer Essentials Towels, bed sheets, soap, and toilet paper Hangers Bed linens Extra pillows and blankets Room-darkening shades Iron Clothing storage Entertainment TV with standard cable Theme room A room or multiple spaces that are designed to follow the same theme Family Pack \u2019n play/Travel crib Children\u2019s books and toys High chair Children\u2019s dinnerware Children's playroom An indoor room with toys, books, and games for children Heating and cooling Air conditioning Ceiling fan Heating Home safety Exterior security cameras on property","section":"AMENITIES","line":74,"scores":{"party_welcome":0.0002516561362426728,"social_amenities":0.004628551192581654,"party_restriction":0.002805905882269144,"nearby_nightlife":0.0009748859447427094}},{"text":"Climbing the magnificent central staircase, which the house was designed around, you'll discover three beautifully appointed bedrooms (two kings and one queen) along with two freshly renovated and meticulously designed full bathrooms. Abundant storage space ensures your comfort, and there's ample room to retreat and unwind. We hope that you enjoy the classic, Southern sophistication our home has to offer! We like to think of it as a place where history meets comfort, where old-world character meets modern design, and where unforgettable Savannah memories are made! Guest access","section":"FULL DESCRIPTION","line":62,"scores":{"party_welcome":0.0006170929991640151,"social_amenities":0.003687050426378846,"party_restriction":0.0025773076340556145,"nearby_nightlife":0.003914546687155962}}],"nearby_nightlife":[{"text":"The adjacent dining room is a grand space, ideal for entertaining friends and family. And for the mornings where you need a quick bite before you're off to explore all that Savannah has to offer...there's a cozy breakfast area just off the kitchen! Step towards the back of the house and you'll find the large sunroom, filled with natural light and perfect for indulging in a good book with a cup of coffee. Our powder room is adorned with a gorgeous, hand painted, mural wallpaper by a local artist!","section":"FULL DESCRIPTION","line":60,"scores":{"party_welcome":0.9698008894920349,"social_amenities":0.0035015279427170753,"party_restriction":0.00039957405533641577,"nearby_nightlife":0.23830357193946838}},{"text":"Outside in the small garden, you'll find a little seating area and a propane grill, which offers opportunities for relaxation and al fresco dining. As you step inside, you'll be captivated by the seamless blend of original architecture and modern amenities. The first floor condo welcomes you with a spacious living room featuring a flat-screen TV, speedy fast WiFi, and ample seating. If you want some home cooked meals, a full kitchen and dining area awaits. Get some rest in the two king primary suites too! Upstairs, you will find another living room and another large galley style kitchen.","section":"FULL DESCRIPTION","line":56,"scores":{"party_welcome":0.00015084791812114418,"social_amenities":0.21728083491325378,"party_restriction":0.0004893666482530534,"nearby_nightlife":0.01562558114528656}}]}}},{"listing_id":"934205861756893522","title":"Garden Level Retreat in 1810 Federalist Home","url":"https://www.airbnb.com/rooms/934205861756893522","guests":4.0,"permits":["SVR-02755"],"analysis":null},{"listing_id":"972496509569040867","title":"White House Estate Near Columbia Square","url":"https://www.airbnb.com/rooms/972496509569040867","guests":6.0,"permits":["SVR-02754"],"analysis":null}],"complete":false},{"pin":"20005 24005","address":"504 E PRESIDENT ST","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-distu