":[],"social_evidence":[],"evidence":{"party_welcome":[],"social_amenities":[],"party_restriction":[],"nearby_nightlife":[]}}}],"complete":true},{"pin":"20014 19008","address":"530 E JONES ST","permit_type":"non_owner","approved_guests":8.0,"advertised_guests":6.0,"neighbor_count":2,"counts":{"direct":{"All calls":1,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":4,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":5,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[{"number":"25187189997","date":"2025-07-06","type":"42 PAST THEFT","outcome":"Other","recorded_address":"530 E Jones St","recorded_pin":"20014 19008","side":"direct"},{"number":"25028025090","date":"2025-01-28","type":"41 PAST VEHICLE THEFT","outcome":"Other","recorded_address":"532 E Jones St","recorded_pin":"20014 19007","side":"neighbors"},{"number":"25273277253","date":"2025-09-30","type":"14 PHONE HARASSMENT","outcome":"Other","recorded_address":"532 E Jones St","recorded_pin":"20014 19007","side":"neighbors"},{"number":"26259269178","date":"2026-09-16","type":"14 PAST THREAT","outcome":"Other","recorded_address":"532 E Jones St","recorded_pin":"20014 19007","side":"neighbors"},{"number":"26280291135","date":"2026-10-07","type":"59-4 INDECENCY/LEWDNESS","outcome":"Other","recorded_address":"532 E Jones St","recorded_pin":"20014 19007","side":"neighbors"}],"listings":[{"listing_id":"1087826166694685272","title":"Cozy Home on Famous Jones Street in Historic Dist","url":"https://www.airbnb.com/rooms/1087826166694685272","guests":6.0,"permits":["SVR-00768"],"analysis":{"listing_id":"1087826166694685272","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"58f9bd6e5e9c953ff5e4d1ea78dab50d32e3e36c9912c78217d3b0f4ef752907","chunks":6,"words":511,"party_signal":0,"social_signal":0.9547401070594788,"party_welcome":0.32833895087242126,"social_amenities":0.9547401070594788,"party_restriction":0.002983817597851157,"nearby_nightlife":0.9124755859375,"signal_evidence":[],"social_evidence":[{"text":"On the other side of the original brick fireplace is the dining room, with enough space and seating to accommodate six Lucky guests. A half-bath is conveniently tucked away under the staircase. The large kitchen has been completely remodeled to have stainless steel appliances and everything you need to cook a family meal at \u201chome.\u201d The door off the kitchen leads to the porch and private courtyard. With plenty of seating and even a fire pit, this outdoor space is great for entertaining. Upstairs you\u2019ll find a full bath a shower/tub combo shared by two of the bedrooms.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.32833895087242126,"social_amenities":0.9547401070594788,"party_restriction":0.0003105743962805718,"nearby_nightlife":0.06321921944618225}},{"text":"Allure on Jones achieves the perfect blend of historical character and modern comfort. The space This townhouse on East Jones Street will have you feeling like a local in no time! With nothing but a key code between you and the cobblestones of \u201cAmerica\u2019s prettiest street\u201d - dubbed so by Southern Living Magazine - you\u2019ll have all the convenience of home without having to lug around your keys. The living room has a large couch and TV, so you can kick off your shoes and get started on the best part of a vacation - relaxing.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.00010633188503561541,"social_amenities":0.0012179715558886528,"party_restriction":0.0004256372048985213,"nearby_nightlife":0.0009669269784353673}}],"evidence":{"party_welcome":[{"text":"On the other side of the original brick fireplace is the dining room, with enough space and seating to accommodate six Lucky guests. A half-bath is conveniently tucked away under the staircase. The large kitchen has been completely remodeled to have stainless steel appliances and everything you need to cook a family meal at \u201chome.\u201d The door off the kitchen leads to the porch and private courtyard. With plenty of seating and even a fire pit, this outdoor space is great for entertaining. Upstairs you\u2019ll find a full bath a shower/tub combo shared by two of the bedrooms.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.32833895087242126,"social_amenities":0.9547401070594788,"party_restriction":0.0003105743962805718,"nearby_nightlife":0.06321921944618225}},{"text":"The first bedroom has a twin bed with trundle, perfect for guests traveling with children. The second bedroom has a queen sized bed, TV, and wardrobe, so you can unpack and settle in. The primary bedroom is complete with a TV, closet, dresser, and en suite bath with a sleek, glass shower. Go ahead, take a long shower: A tankless water heater ensures you won\u2019t run out of hot water! Why Lucky Savannah Loves this Property: - Located in the residential area of the Historic District you\u2019ll live like a local, and be only minutes from any tourist point of interest you desire.","section":"FULL DESCRIPTION","line":45,"scores":{"party_welcome":0.00042981974547728896,"social_amenities":0.000743602984584868,"party_restriction":0.0003034023684449494,"nearby_nightlife":0.9124755859375}}],"social_amenities":[{"text":"On the other side of the original brick fireplace is the dining room, with enough space and seating to accommodate six Lucky guests. A half-bath is conveniently tucked away under the staircase. The large kitchen has been completely remodeled to have stainless steel appliances and everything you need to cook a family meal at \u201chome.\u201d The door off the kitchen leads to the porch and private courtyard. With plenty of seating and even a fire pit, this outdoor space is grea