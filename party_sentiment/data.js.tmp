oric District. You'll find original features such as exposed brick walls, beautifully restored hardwood floors, and an unbeatable location that is steps away from high end shopping, Savannah's food scene and lively nightlife! Our fully equipped kitchen is a chef's dream, boasting stainless steel appliances and all the essentials you need to prepare delicious meals. Enjoy your morning coffee at the kitchen island, or gather around the dining table for a leisurely meal. There is a Keurig coffee pot and K-Cups provided.","section":"FULL DESCRIPTION","line":47,"scores":{"party_welcome":0.0025722745340317488,"social_amenities":0.002868675161153078,"party_restriction":0.00045061143464408815,"nearby_nightlife":0.9581145644187927}}]}}}],"complete":true},{"pin":"20016 15018","address":"310 W BROUGHTON ST #2003","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[],"listings":[{"listing_id":"957337553333199967","title":"Broughton Blue Belle Luxury 2BD|1BA Historic Condo","url":"https://www.airbnb.com/rooms/957337553333199967","guests":4.0,"permits":["SVR-02837"],"analysis":null}],"complete":false},{"pin":"20016 15022","address":"310 W BROUGHTON ST #2007","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"D