ores":{"party_welcome":0.0002931114286184311,"social_amenities":0.06121480464935303,"party_restriction":0.015143423341214657,"nearby_nightlife":0.007873263210058212}},{"text":"Hot water kettle Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Location features Private entrance Separate street or building entrance Outdoor Patio or balcony Outdoor furniture Parking and facilities Free street parking Pool Services Pets allowed Assistance animals are always allowed Self check-in Keypad Check yourself into the home with a door code","section":"AMENITIES","line":228,"scores":{"party_welcome":0.0014107063179835677,"social_amenities":0.03104274906218052,"party_restriction":0.0018025434110313654,"nearby_nightlife":0.0010163418482989073}}],"nearby_nightlife":[{"text":"Situated along East Oglethorpe Avenue beside Colonial Park Cemetery, the property places you in the middle of Savannah\u2019s Historic District and within easy reach of many of the city\u2019s best-known attractions. From the property, guests can set out on foot to explore nearby squares, historic homes, museums, restaurants, shops, and landmarks. Oglethorpe Square and Columbia Square are both nearby, while the Owens-Thomas House & Slave Quarters offers an opportunity to learn more about Savannah\u2019s history and architecture. Continue toward Broughton Street for shopping, coffee, dining, and local boutiques, or make your way toward City Market for galleries, restaurants, and entertainment.","section":"FULL DESCRIPTION","line":85,"scores":{"party_welcome":0.00012441420403774828,"social_amenities":0.0015713307075202465,"party_restriction":0.0005028042360208929,"nearby_nightlife":0.9571281671524048}},{"text":"Savannah offers no shortage of restaurants, caf\u00e9s, bakeries, and coffee shops, but having the option to prepare something on your own can make each day feel more relaxed. It is especially convenient for early mornings, late arrivals, or evenings when your group would rather stay in. The kitchen also provides useful storage for groceries and restaurant leftovers. Pick up something from a local market, bring back dessert from a nearby restaurant, or prepare coffee before beginning another day downtown. In-home laundry is available on the garden level, adding another layer of convenience for longer stays, family trips, or guests who prefer to pack light.","section":"FULL DESCRIPTION","line":59,"scores":{"party_welcome":0.0002626599743962288,"social_amenities":0.001967174466699362,"party_restriction":0.00045531874638982117,"nearby_nightlife":0.8650841116905212}}]}}}],"complete":true},{"pin":"20015 06020","address":"133 LINCOLN ST","permit_type":"non_owner","approved_guests":6.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":4,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":4,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[{"number":"24300314767","date":"2024-10-26","type":"UNCONSCIOUS-LIFE STATSUS UNK","outcome":"Other","recorded_address":"221 E York St","recorded_pin":"20015 06006","side":"neighbors"},{"number":"25051047407","date":"2025-02-20","type":"OPEN DOOR","outcome":"Other","recorded_address":"221 E YORK ST","recorded_pin":"20015 06006","side":"neighbors"},{"number":"26038035860","date":"2026-02-07","type":"15B RESIDENTIAL BURGLARY","outcome":"Other","recorded_address":"135 LINCOLN ST","recorded_pin":"20015 06020A","side":"neighbors"},{"number":"26094095373","date":"2026-04-04","type":"15B RESIDENTIAL BURGLARY","outcome":"Other","recorded_address":"135 LINCOLN ST","recorded_pin":"20015 06020A","side":"neighbors"}],"listings":[{"listing_id":"42112006","title":"High Ceilings and Historic by Lucky Savannah","url"