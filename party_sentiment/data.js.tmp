lete":true},{"pin":"20014 13026","address":"513 E LIBERTY ST","permit_type":"non_owner","approved_guests":12.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":1,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":1,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[{"number":"24097102262","date":"2024-04-06","type":"CHOKING-E","outcome":"Other","recorded_address":"513 E Liberty St","recorded_pin":"20014 13026","side":"direct"}],"listings":[{"listing_id":"1390098549434040908","title":"Stunning Downtown Double Master Suite Townhome","url":"https://www.airbnb.com/rooms/1390098549434040908","guests":4.0,"permits":["SVR-03118"],"analysis":{"listing_id":"1390098549434040908","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"2254a892a6a6ca8d98faebd9958816b2528a7a86ae803e9a2521eb754ba533a2","chunks":9,"words":790,"party_signal":0.002604637062177062,"social_signal":0.8393762707710266,"party_welcome":0.002604637062177062,"social_amenities":0.8393762707710266,"party_restriction":0.44405025243759155,"nearby_nightlife":0.6821386218070984,"signal_evidence":[{"text":"This warm and inviting home perfectly blends classic Southern charm with modern comforts, making it an ideal choice for couples, friends, families, or small reunions looking to experience Savannah like a local. Step inside and feel instantly at ease in this thoughtfully designed space where every detail has been chosen to enhance your stay. The entire second-floor unit comfortably sleeps up to four guests with two private bedrooms \u2014 the first with a luxurious king-size bed and the second with a queen bed \u2014 each boasting its own spacious full bathroom with marble walk-in showers.","section":"FULL DESCRIPTION","line":48,"scores":{"party_welcome":0.002604637062177062,"social_amenities":0.0015218013431876898,"party_restriction":0.0001789728266885504,"nearby_nightlife":0.001682531670667231},"affirmative_event_evidence":"This warm and inviting home perfectly blends classic Southern charm with modern comforts, making it an ideal choice for couples, friends, families, or small reunions looking to experience Savannah like a local."}],"social_evidence":[{"text":"Guests will have exclusive access to the entire private apartment, along with shared access to the peaceful courtyard located on the property. The courtyard is a lovely spot to enjoy morning coffee or unwind in the evening. Entry is via self check-in with a secure keypad, allowing for a smooth and flexible arrival. Street parking is available nearby and is free, though guests should be mindful of posted street-sweeping signage and metered streets on neighboring streets. Other things to note We are a smoke free property. This includes No vaping. Smoking and vaping is not allowed in the Courtyard.","section":"FULL DESCRIPTION","line":61,"scores":{"party_welcome":0.00011349014675943181,"social_amenities":0.8393762707710266,"party_restriction":0.44405025243759155,"nearby_nightlife":0.35987088084220886}},{"text":"There\u2019s also a convenient half bath on the main floor and a comfy king sofa bed in the living room for extra flexibility. Relax in the stylish living area with a smart TV, whip up your favorite meals in the fully equipped kitchen complete with stainless steel appliances, granite countertops, a coffee bar, and a dishwasher, or take care of laundry with the in-unit washer and dryer. Step outside to enjoy your morning coffee or evening wine in the shared courtyard, a peaceful oasis right in the Historic District.","section":"FULL DESCRIPTION","line":50,"scores":{"party_welcome":0.0005024128477089107,"social_amenities":0.5871075391769409,"party_restriction":0.0009333890047855675,"nearby_nightlife":0.2532505989074707}}],"evidence":{"party_welcome":[{"text":"This warm and inviting home perfectly blends classic Southern charm with modern comforts, making it an ideal choice for couples, friends, families, or small reunions looking to experience Savannah like a local. Step inside and feel instantly at ease in this thoughtfully designed space where every detail has been chosen to enhance your stay. The entire second-floor unit comfortably sleeps up to four guests with two private bedrooms \u2014 the first with a luxurious king-size bed and the second with a queen bed \u2014 each boasting its own spacious full bathroom with marble walk-in showers.","section":"FULL DESCRIPTION","line":48,"scores":{"party_welcome":0.002604637062177062,"social_amenities":0.0015218013431876898,"party_restriction":0.0001789728266885504,"nearby_nightlife":0.001682531670667231}},{"text":"Located just blocks from Savannah\u2019s most beloved sights, you\u2019re within easy stroll of iconic squares, scenic parks, the Downtown Design District\u2019s local shops, and a variety of celebrated restaurants and caf\u00e9s. Wander cobblestone streets, soak up the rich history around every corner, or simply savor the gentle Southern breeze from your courtyard retreat. Whether you\u2019re here for a girls\u2019 weekend, family getaway, or a romantic escape, this home is the perfect blend of comfort, walkability, and historic charm. Book today and start making unforgettable memories in enchanting Savannah! Permit License Number: SVR-03118 Guest access","section":"FULL DESCRIPTION","line":54,"scores":{"party_welcome":0.0008049032185226679,"social_amenities":0.008305592462420464,"party_restriction":0.004582155961543322,"nearby_nightlife":0.5306384563446045}}],"social_amenities":[{"text":"Guests will have exclusive access to the entire private apartment, along with shared access to the peaceful courtyard located on the property. The courtyard is a lovely spot to enjoy morning coffee or unwind in the evening. Entry is via self check-in with a secure keypad, allowing for a smooth and flexible arrival. Street parking is available nearby and is free, though guests should be mindful of posted street-sweeping signage and metered streets on neighboring streets. Other things to note We are a smoke free property. This includes No vaping. Smoking and vaping is not allowed in the Courtyard.","section":"FULL DESCRIPTION","line":61,"scores":{"party_welcome":0.00011349014675943181,"social_amenities":0.8393762707710266,"party_restriction":0.44405025243759155,"nearby_nightlife":0.35987088084220886}},{"text":"There\u2019s also a convenient half bath on the main floor and a comfy king sofa bed in the living room for extra flexibility. Relax in the stylish living area with a smart TV, whip up your favorite meals in the fully equipped kitchen complete with stainless steel appliances, granite countertops, a coffee bar, and a dishwasher, or take care of laundry with the in-unit washer and dryer. Step outside to enjoy your morning coffee or evening wine in the shared courtyard, a peaceful oasis right in the Historic District.","section":"FULL DESCRIPTION","line":50,"scores":{"party_welcome":0.0005024128477089107,"social_amenities":0.5871075391769409,"party_restriction":0.0009333890047855675,"nearby_nightlife":0.2532505989074707}}],"party_restriction":[{"text":"Guests will have exclusive access to the entire private apartment, along with shared access to the peaceful courtyard located on the property. The courtyard is a lovely spot to enjoy morning coffee or unwind in the evening. Entry is via self check-in with a secure keypad, allowing for a smooth and flexible arrival. Street parking is available nearby and is free, though guests should be mindful of posted street-sweeping signage and metered streets on neighboring streets. Other things to note We are a smoke free property. This includes No vaping. Smoking and vaping is not allowed in 