26088089950","date":"2026-03-29","type":"31 CHECK-THE-WELFARE","outcome":"Other","recorded_address":"531 E Jones St","recorded_pin":"20033 01040","side":"direct"},{"number":"26171177919","date":"2026-06-20","type":"57 MISSING (AT RISK)","outcome":"Other","recorded_address":"531 E Jones St","recorded_pin":"20033 01040","side":"direct"}],"listings":[{"listing_id":"32240429","title":"Historic on Jones w/ Backyard by Lucky Savannah","url":"https://www.airbnb.com/rooms/32240429","guests":10.0,"permits":["SVR-00128"],"analysis":{"listing_id":"32240429","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"23d35f0c13903e63f66573a002c8fd8103b20a5371988816a0bb5dcce38257f1","chunks":7,"words":577,"party_signal":0.9779070615768433,"social_signal":0.885784924030304,"party_welcome":0.9779070615768433,"social_amenities":0.885784924030304,"party_restriction":0.002983817597851157,"nearby_nightlife":0.9282867312431335,"signal_evidence":[{"text":"Nestled beneath the Spanish Moss Trees on America's Most Beautiful Street, this large home can accommodate up to 10 Lucky Guests! Enjoy having a private backyard, parking for three vehicles, and an ample amount of space for your guests to hangout. The space This three bedroom, two-and-a-half bath home is located on historic Jones Street, named America\u2019s Prettiest Street by Southern Living Magazine. Originally two smaller cottages converted into one home, Savannah Selfies can sleep up to 10 Lucky guests, and is perfect for family gatherings or a girls weekend!","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.9779070615768433,"social_amenities":0.0005835870979353786,"party_restriction":0.0003751362964976579,"nearby_nightlife":0.009357278235256672},"affirmative_event_evidence":"Originally two smaller cottages converted into one home, Savannah Selfies can sleep up to 10 Lucky guests, and is perfect for family gatherings or a girls weekend!"}],"social_evidence":[{"text":"You\u2019ll enter into a small foyer which is separated from the L shaped living area by a double sided, decorative fireplace. The living area features two separate seating areas, each with pops of color, and original hardwood floors. The spacious kitchen and dining area have both a large dining table and breakfast bar. The kitchen has direct access to the private backyard, where you\u2019ll find a deck with a cozy seating area, a dining table and a grill. Two of the three bedrooms are on the ground floor.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.0003443825407885015,"social_amenities":0.885784924030304,"party_restriction":0.0003475427511148155,"nearby_nightlife":0.01505137700587511}},{"text":"Allow stay for 28 days or more Self check-in Smart lock","section":"AMENITIES","line":114,"scores":{"party_welcome":0.0003030583611689508,"social_amenities":0.0009171758429147303,"party_restriction":0.002983817597851157,"nearby_nightlife":0.0016854784917086363}}],"evidence":{"party_welcome":[{"text":"Nestled beneath the Spanish Moss Trees on America's Most Beautiful Street, this large home can accommodate up to 10 Lucky Guests! Enjoy having a private backyard, parking for three vehicles, and an ample amount of space for your guests to hangout. The space This three bedroom, two-and-a-half bath home is located on historic Jones Street, named America\u2019s Prettiest Street by Southern Living Magazine. Originally two smaller cottages converted into one home, Savannah Selfies can sleep up to 10 Lucky guests, and is perfect for family gatherings or a girls weekend!","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.9779070615768433,"social_amenities":0.0005835870979353786,"party_restriction":0.0003751362964976579,"nearby_nightlife":0.009357278235256672}},{"text":"The primary bedroom has a King sized bed, TV, writing desk, and en suite bath with double sinks and access to the backyard. The second bedroom is a cozy space with a comfortable Queen bed. The stunning staircase to the second floor adds a modern flare to the home. The upstairs loft has two separate spaces, one with a day bed and trundle, the other with two twin beds and an attached half bath. Savannah Selfies is ideally located in walking distance to shops, restaurants and other area attractions.","section":"FULL DESCRIPTION","line":45,"scores":{"party_welcome":0.00035496841883286834,"social_amenities":0.0017462457763031125,"party_restriction":0.0006720629753544927,"nearby_nightlife":0.9282867312431335}}],"social_amenities":[{"text":"You\u2019ll enter into a small foyer which is separated from the L shaped living area by a double sided, decorative fireplace. The living area features two separate seating areas, each with pops of color, and original hardwood floors. The spacious kitchen and dining area have both a large dining table and breakfast bar. The kitchen has direct access to the private backyard, where you\u2019ll find a deck with a cozy seating area, a dining table and a grill. Two of the three bedrooms are on the ground floor.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.0003443825407885015,"social_amenities":0.885784924030304,"party_restriction":0.0003475427511148155,"nearby_nightlife":0.01505137700587511}},{"text":"The primary bedroom has a King sized bed, TV, writing desk, and en suite bath with double sinks and access to the backyard. The second bedroom is a cozy space with a comfortable Queen bed. The stunning staircase to the second floor adds a modern flare to the home. The upstairs loft has two separate spaces, one with a day bed and trundle, the other with two twin beds and an attached half bath. Savannah Selfies is ideally located in walking distance to shops, restaurants and other area attractions.","section":"FULL DESCRIPTION","line":45,"scores":{"party_welcome":0.00035496841883286834,"social_amenities":0.0017462457763031125,"party_restriction":0.0006720629753544927,"nearby_nightlife":0.9282867312431335}}],"party_restriction":[{"text":"Allow stay for 28 days or more Self check-in Smart lock","section":"AMENITIES","line":114,"scores":{"party_welcome":0.0003030583611689508,"social_amenities":0.0009171758429147303,"party_restriction":0.002983817597851157,"nearby_nightlife":0.0016854784917086363}},{"text":"Simply stroll down beautiful Jones Street to Clary\u2019s Cafe, featured in Midnight In the Garden of Good and Evil, and a favorite of locals and visitors alike. A few blocks away at the corner of Bull Street and Liberty, you\u2019ll find local shops featuring everything from handmade handbags and leather goods at Satchel, to Celtic crosses at Saints & Shamrocks. Sleeping Configuration: Bedroom 1: King Bed Bedroom 2: Queen Bed Bedroom 3: Two Twin Beds Loft: Daybed with Trundle Living Room: Queen Sleeper Sofa Parking: Non-metered Parking This unit has free, on-street parking right outside the front door. Availability will depend on time of day and season.","section":"FULL DESCRIPTION","line":47,"scores":{"party_welcome":0.00028852419927716255,"social_amenities":0.0009644613019190729,"party_restriction":0.0011910781031474471,"nearby_nightlife":0.9262521266937256}}],"nearby_nightlife":[{"text":"The primary bedroom has a King sized bed, TV, writing desk, and en suite bath with double sinks and access to the backyard. The second bedroom is a cozy space with a comfortable Queen bed. The stunning staircase to the second floor adds a modern flare to the home. The upstairs loft has two separate spaces, one with a day bed and trundle, the other with two twin beds and an attached half bath. Savannah Selfies is ideally located in walking distance to shops, restaurants and other area attractions.","section":"FULL DESCRIPTION","line":45,"scores":{"party_welcome":0.00035496841883286834,"social_amenities":0.0017462457763031125,"party_restriction":0.0006720629753544927,"nearby_nightlife":0.9282867312431335}},{"text":"Simply stroll down beautiful Jones Street to Clary\u2019s Cafe, feature