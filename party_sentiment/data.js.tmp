"section":"FULL DESCRIPTION","line":69,"scores":{"party_welcome":0.00017519009998068213,"social_amenities":0.0008857120992615819,"party_restriction":0.002354156691581011,"nearby_nightlife":0.04526778683066368}}],"nearby_nightlife":[{"text":"These streets are EJones St. (east of Abercorn), and any street South of Gaston Street. Both about 5 minute stroll from the apartment. Just be mindful of the street sweeper nights. Show more","section":"FULL DESCRIPTION","line":69,"scores":{"party_welcome":0.00017519009998068213,"social_amenities":0.0008857120992615819,"party_restriction":0.002354156691581011,"nearby_nightlife":0.04526778683066368}},{"text":"Spacious apartment in the most coveted location of Savannah' s Historic District. Private entry on Jones Street named one of the \"Most beautiful street in America\". Feel like a local in a historic mansion that dates back to 1850, walk to all shops and restaurants. Very quiet and peaceful. Garden level, no stairs. Beautiful back courtyard garden and a side courtyard to enjoy your morning coffee. See PARKING INFO on listing. Large bedroom, separate living room, queen sofa-bed in LR. SVR-02204 The space Large living room area, big screen smart tv, comfortable desk/work area. Spacious bedroom with a queen bed and lots of closets.","section":"FULL DESCRIPTION","line":42,"scores":{"party_welcome":0.00010674505756469443,"social_amenities":0.0002199602749897167,"party_restriction":0.0004731355293188244,"nearby_nightlife":0.012644640170037746}}]}}},{"listing_id":"43800563","title":"Historic Carriage House Apartment from 1850","url":"https://www.airbnb.com/rooms/43800563","guests":4.0,"permits":["SVR-02205"],"analysis":{"listing_id":"43800563","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"71c2e5591583a97382dcf32ed093b7745cb8e8c7eecbecc15919fc712bf2908b","chunks":8,"words":779,"party_signal":0,"social_signal":0.1890040785074234,"party_welcome":0.0005900447140447795,"social_amenities":0