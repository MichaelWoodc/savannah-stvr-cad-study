70193207264,"social_amenities":0.005198705941438675,"party_restriction":0.0004743044264614582,"nearby_nightlife":0.04711582884192467}},{"text":"Don't be afraid to reach out if you need anything! We live super close-by and are always happy to help out, even mid-stay. Show more","section":"FULL DESCRIPTION","line":53,"scores":{"party_welcome":0.0008119135745801032,"social_amenities":0.000486511125927791,"party_restriction":0.0005571329966187477,"nearby_nightlife":0.03355703130364418}}]}}}],"complete":true},{"pin":"20053 02021","address":"307 E PARK AVE","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":2,"counts":{"direct":{"All calls":1,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":2,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":3,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[{"number":"24209220824","date":"2024-07-27","type":"42 PAST THEFT","outcome":"Other","recorded_address":"307 E Park Ave","recorded_pin":"20053 02021","side":"direct"},{"number":"25014012935","date":"2025-01-14","type":"***Generic Law Call","outcome":"Other","recorded_address":"305 E Park Ave","recorded_pin":"20053 02020","side":"neighbors"},{"number":"26154158780","date":"2026-06-03","type":"42 PAST THEFT","outcome":"Other","recorded_address":"311 E Park Ave","recorded_pin":"20053 02017","side":"neighbors"}],"listings":[{"listing_id":"46816561","title":"Bright Bohemian Home w/ Parking by Lucky Savannah","url":"https://www.airbnb.com/rooms/46816561","guests":4.0,"permits":["SVR-02241"],"analysis":{"listing_id":"46816561","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"7e75e7f15f67aaa7397196c6ea40dca2066e274fae106db9e0393b96ca56d795","chunks":7,"words":618,"party_signal":0,"social_signal":0.0010722281876951456,"party_welcome":0.30481165647506714,"social_amenities":0.9508250951766968,"party_restriction":0.010173997841775417,"nearby_nightlife":0.9938762784004211,"signal_evidence":[],"social_evidence":[{"text":"What this place offers Bathroom Hair dryer Shampoo Conditioner Body soap Hot water Shower gel Bedroom and laundry Washer Dryer Essentials Towels, bed sheets, soap, and toilet paper Hangers Bed linens Iron Entertainment TV with standard cable Heating and cooling Air conditioning Heating Home safety Smoke alarm Carbon monoxide alarm Fire extinguisher Internet and office Wifi Dedicated workspace Kitchen and dining Kitchen Space where guests can cook their own meals Refrigerator Microwave Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Dishwasher Stove Oven Coffee maker Toaster Coffee Location features Private entrance Separate street or building entrance Parking and facilities Free parking on premises Services Pets allowed","section":"AMENITIES","line":67,"scores":{"party_welcome":0.0002373594616074115,"social_amenities":0.0010722281876951456,"party_restriction":0.0003062019241042435,"nearby_nightlife":0.00046924842172302306}},{"text":"maximum weight limit per dog and a limit of 2 dogs per reservation. Some homes may allow larger dogs, please inquire for more information. SVR-02241 Other things to note AGE RESTRICTION: All renters must be over the age of 25, unless it is a child accompanied by a parent. If a guest is found to have falsified their reservation in any way we reserve the right to evict the guest, cancel their reservation and retain ALL DEPOSITS PAID TO THAT POINT. Show more","section":"FULL DESCRIPTION","line":58,"scores":{"party_welcome":7.269021443789825e-05,"social_amenities":0.0007316641276702285,"party_restriction":0.0006744626443833113,"nearby_nightlife":0.0005770304705947638}}],"evidence":{"party_welcome":[{"text":"Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to four Lucky Guests very comfortably, and features all of the amenities one could wish for! The space Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to Four Lucky Guests very comfortably, and features all of the amenities one could wish for! The open floor plan creates an inviting environment, and makes entertaining a breeze.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.30481165647506714,"social_amenities":0.9508250951766968,"party_restriction":0.003584847319871187,"nearby_nightlife":0.5355452299118042}},{"text":"While you are preparing a home cooked meal in the kitchen, you'll never feel separated from the living room, as guests can converse through the home seamlessly. In addition to the open floor plan, the natural light beams through the large windows from the front to the back of the home. The kitchen features a chefs dream - a gas stove, plenty of counter space, and a butcher block island for serving! For those who love outdoor living, you'll love the back patio space just off of the kitchen. Enjoy cocktails at dusk with the caf\u00e9 lights, or a morning read with a cup of joe.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.001453857752494514,"social_amenities":0.2609140872955322,"party_restriction":0.00020020503143314272,"nearby_nightlife":0.6990272402763367}}],"social_amenities":[{"text":"Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to four Lucky Guests very comfortably, and features all of the amenities one could wish for! The space Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to Four Lucky Guests very comfortably, and features all of the amenities one could wish for! The open floor plan creates an inviting environment, and makes entertaining a breeze.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.30481165647506714,"social_amenities":0.9508250951766968,"party_restriction":0.003584847319871187,"nearby_nightlife":0.5355452299118042}},{"text":"While you are preparing a home cooked meal in the kitchen, you'll never feel separated from the living room, as guests can converse through the home seamlessly. In addition to the open floor plan, the natural light beams through the large windows from the front to the back of the home. The kitchen features a chefs dream - a gas stove, plenty of counter space, and a butcher block island for serving! For those who love outdoor living, you'll love the back patio space just off of the kitchen. Enjoy cocktails at dusk with the caf\u00e9 lights, or a morning read with a cup of joe.","section":"FULL DESCRIPTION","line":43,"scores":{"party_welcome":0.001453857752494514,"social_amenities":0.2609140872955322,"party_restriction":0.00020020503143314272,"nearby_nightlife":0.6990272402763367}}],"party_restriction":[{"text":"Take the scenic route through downtown's beautiful squares and end at the well-known River Walk - a great place to grab a beer and people watch. What Is Parking Like For This Home? Guests can find one private parking space directly behind the home. All other parking is on-street, non-metered directly in front of the home. Sleeping Configuration: Bedroom 1: King Size Bed Bedroom 2: Queen Size Bed We can welcome your dog companions at this pet friendly home, but ask that you find other arrangements for cats, birds, and other furry friends. There is a $130 pet fee (non-refundable) with a 35 lb.","section":"FULL DESCRIPTION","line":49,"scores":{"party_welcome":0.00015820207772776484,"social_amenities":0.03389477729797363,"party_restriction":0.010173997841775417,"nearby_nightlife":0.9074414968490601}},{"text":"Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to four Lucky Guests very comfortably, and features all of the amenities one could wish for! The space Situated in the Victorian District, East Park Bungalow, is an eye-catching town home just three short blocks from Forsyth Park. This property can accommodate up to Four Lucky Guests very comfortably, and features all of the amenities one could wish for! The open floor plan creates an inviting environment, and makes entertaining a breeze.","section":"FULL DESCRIPTION","line":38,"scores":{"party_welcome":0.30481165647506714,"social_amenities":0.9508250951766968,"party_restriction":0.003584847319871187,"nearby_nightlife":0.5355452299118042}}],"nearby_nightlife":[{"text":"The back yard is a rarity here in the Victorian Historic District, and you will have ample amount of space for your activity of choice. Upstairs both suites await with plush beds, ensuite bathrooms, and plenty of space to store your belongings. The full-size washer and dryer can be found atop of the stairs, which is perfect for extended stays! Head South a few blocks and find yourself immersed in Savannah's culture - with a wine bar, vegan cafe, and the Forsyth Park Farmer's Market. A few minutes' walk in the other direction gets you closer to the bustling city.","section":"FULL DESCRIPTION","line":45,"scores":{"party_welcome":0.0010875905863940716,"social_amenities":0.00408516451716423,"party_restriction":0.0014176367549225688,"nearby_nightlife":0.9938762784004211}},{"text":"Take the scenic route through downtown's beautiful squares and end at the well-known River Walk - a great place to grab a beer and people watch. What Is Parking Like For This Home? Guests can find one private parking space directly behind the home. All other parking is on-street, non-metered directly in front of the home. Sleeping Configuration: Bedroom 1: King Size Bed Bedroom 2: Queen Size Bed We can welcome your dog companions at this pet friendly home, but ask that you find other arrangements for cats, birds, and other furry friends. There is a $130 pet fee (non-refundable) with a 35 lb.","section":"FULL DESCRIPTION","line":49,"scores":{"party_welcome":0.00015820207772776484,"social_amenities":0.03389477729797363,"party_restriction":0.010173997841775417,"nearby_nightlife":0.9074414968490601}}]}}}],"complete":true},{"pin":"20053 03004","address":"116 E HENRY ST","permit_type":"non_owner","approved_guests":8.0,"advertised_guests":10.0,"neighbor_count":1,"counts":{"direct":{"All calls":3,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":21,"Noise-party-disturbance":3,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":3},"combined":{"All calls":24,"Noise-party-disturbance":3,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":3}},"calls":[{"number":"24133140467","date":"2024-05-12","type":"70 PROPERTY/VACATION CHECK","outcome":"Other","recorded_address":"116 E Henry St","recorded_pin":"20053 03004","side":"direct"},{"number":"25151153300","date":"2025-05-31","type":"41 PAST VEHICLE THEFT","outcome":"Other","recorded_address":"116 E Henry St","recorded_pin":"20053 03004","side":"direct"},{"number":"25266269569","date":"2025-09-23","type":"67 WANTED vehicle","outcome":"Other","recorded_address":"116 E Henry St","recorded_pin":"20053 03004","side":"direct"},{"number":"24113119144","date":"2024-04-22","type":"59 PAST SEXUAL ASSAULT CHOKED","outcome":"Other","recorded_address":"122 E Henry St","recorded_pin":"20053 03003","side":"neighbors"},{"number":"24132140119","date":"2024-05-11","type":"71 SUSPICIOUS ACTIVITY","outcome":"Other","recorded_address":"122 E Henry St","recorded_pin":"20053 03003","side":"neighbors"},{"number":"24166176562","da