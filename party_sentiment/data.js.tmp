","source_sha256":"acf8c5960a21cc469cdb4feb700b676b9554571ce5d4e1d32d4853a410e6403e","chunks":15,"words":1360,"party_signal":0,"social_signal":0.024505313485860825,"party_welcome":0.0007147064316086471,"social_amenities":0.024505313485860825,"party_restriction":0.9983049631118774,"nearby_nightlife":0.9826734662055969,"signal_evidence":[],"social_evidence":[{"text":"In a room with a door Kitchen and dining Kitchen Space where guests can cook their own meals Refrigerator Microwave Cooking basics Pots and pans, oil, salt and pepper Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Freezer Dishwasher Frigidaire stainless steel gas stove Oven Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Coffee Location features Private entrance Separate street or building entrance Laundromat nearby Outdoor Private patio or balcony Parking and facilities Free parking on premises Elevator The home or building has an elevator that\u2019s at least 52 inches deep and a doorway at least 32 inches wide Paid parking off premises Single level home","section":"AMENITIES","line":148,"scores":{"party_welcome":0.0004441167402546853,"social_amenities":0.024505313485860825,"party_restriction":0.001465691369958222,"nearby_nightlife":0.0023486476857215166}},{"text":"- Plush Linens & Towels: We've thought of everything to make your stay comfortable, including high-quality linens and towels. You'll find sheet sets and quilts for all bed sizes, as well as white bath towels, hand towels, and washcloths. - Well-Equipped Kitchens: Whether you\u2019re cooking a family meal or just grabbing a snack, our kitchens have you covered. We\u2019ve stocked them with supplies to cook a delicious meal, including a full set of pots and pans, cups, plates, bowls, measuring cups, mixing bowls, and a toaster, to name a some items. We also supply a starter pack of dish cloths, dish soap, dishwasher detergent, salt and pepper.","section":"FULL DESCRIPTION","line":73,"scores":{"party_welcome":0.00027009390760213137,"social_amenities":0.009389538317918777,"party_restriction":0.0009762597619555891,"nearby_nightlife":0.0008276011794805527}}],"evidence":{"party_welcome":[{"text":"- City Market: Enjoy lively restaurants, boutiques, and live music just a short walk away. Vinny Van Go Go's, a beloved local pizza haven, is a must-try! - Broughton Street & Forsyth Park: Discover charming shops and iconic sites, including the beautiful Forsyth Park, all within a few blocks. Dining at Your Doorstep Onsite Options: If you prefer to dine close by, you\u2019ll love having Five Guys, YATAI ramen + yakitori, and Starbucks right in the same building. For a top-notch dining experience, Ruth's Chris Steakhouse is just next door. Stocked for Your Comfort","section":"FULL DESCRIPTION","line":64,"scores":{"party_welcome":0.0007147064316086471,"social_amenities":0.003715560771524906,"party_restriction":0.001097945962101221,"nearby_nightlife":0.9826734662055969}},{"text":"Enjoy a fully equipped kitchen with stainless steel appliances, in-unit laundry, Smart TVs in every room, and a standing balcony with views of the Savannah River and City Market. The building includes an elevator for easy access, and a parking pass is provided for nearby garage parking. Perfectly located in Savannah\u2019s historic district, you\u2019re steps away from River Street, City Market, and top dining options. Show more","section":"FULL DESCRIPTION","line":104,"scores":{"party_welcome":0.0005496164667420089,"social_amenities":0.005202337168157101,"party_restriction":0.0006816958193667233,"nearby_nightlife":0.8985242247581482}}],"social_amenities":[{"text":"In a room with a door Kitchen and dining Kitchen Space where guests can cook their own meals Refrigerator Microwave Cooking basics Pots and pans, oil, salt and pepper Dishes and silverware Plates, bowls, cups, cutlery, and other utensils Freezer Dishwasher Frigidaire stainless steel gas stove Oven Coffee maker Wine glasses Toaster Baking sheet Blender Dining table Coffee Location features Private entrance Separate street or building entrance Laundromat nearby Outdoor Private patio or balcony Parking and facilities Free parking on premises Elevator The home or building has an elevator that\u2019s at least 52 inches deep and a doorway at least 32 inches wide Paid parking off premises Single level home","section":"AMENITIES","line":148,"scores":{"party_welcome":0.0004441167402546853,"social_amenities":0.024505313485860825,"party_restriction":0.001465691369958222,"nearby_nightlife":0.0023486476857215166}},{"text":"- Plush Linens & Towels: We've thought of everything to make your stay comfortable, including high-quality linens and towels. You'll find sheet sets and quilts for all bed sizes, as well as white bath towels, hand towels, and washcloths. - Well-Equipped Kitchens: Whether you\u2019re cooking a family meal or just grabbing a snack, our kitchens have you covered. We\u2019ve stocked them with supplies to cook a delicious meal, including a full set of pots and pans, cups, plates, bowls, measuring cups, mixing bowls, and a toaster, to name a some items. We also supply a starter pack of dish cloths, dish soap, dishwasher detergent, salt and pepper.","section":"FULL DESCRIPTION","line":73,"scores":{"party_welcome":0.00027009390760213137,"social_amenities":0.009389538317918777,"party_restriction":0.0009762597619555891,"nearby_nightlife":0.0008276011794805527}}],"party_restriction":[{"text":"The neighborhood surrounding this condo is a captivating destination for guests seeking to experience the essence of Savannah's historic district. With cobblestone streets, well-preserved buildings, and picturesque squares adorned with moss-draped oak trees, you\u2019ll be immersed in Southern charm. Visit nearby museums like the Ships of the Sea Maritime Museum and the Telfair Museums, or take a leisurely stroll in Forsyth Park. The diverse culinary scene, featuring Southern specialties and international flavors, makes this area a food lover's paradise. *No parties or third party bookings* A rental agreement is required to be completed upon booking. Guest access We recommend parking in the Whitaker St.","section":"FULL DESCRIPTION","line":93,"scores":{"party_welcome":0.00028259665123187006,"social_amenities":0.0013835640856996179,"party_restriction":0.9983049631118774,"nearby_nightlife":0.9804897904396057}},{"text":"Garage around the corner from the condo. We will allow you to use our parking pass (good for 1 vehicle) for the Whitaker St parking garage during your stay. It must be returned to the table at the entrance of our condo unit when you leave or we will charge you a $200 replacement fee. You may also find street parking at your own expense. Other things to note This luxurious 1,860 sq. ft. condo blends Southern charm with modern convenience. It boasts two spacious king-size bedroom suites with ensuite bathrooms, one featuring grab bars for enhanced accessibility.","section":"FULL DESCRIPTION","line":99,"scores":{"party_welcome":0.00023387746477965266,"social_amenities":0.0016487843822687864,"party_restriction":0.005301615688949823,"nearby_nightlife":0.12314021587371826}}],"nearby_nightlife":[{"text":"- City Market: Enjoy lively restaurants, boutiques, and live music just a short walk away. Vinny Van Go Go's, a beloved local pizza haven, is a must-try! - Broughton Street & Forsyth Park: Discover charming shops and iconic sites, including the beautiful Forsyth Park, all within a few blocks. Dining at Your Doorstep Onsite Options: If you prefer to dine close by, you\u2019ll love having Five Guys, YATAI ramen + yakitori, and Starbucks right in the same building. For a top-notch dining experience, Ruth's Chris Steakhouse is just next door. Stocked for Your Comfort","section":"FULL DESCRIPTION","line":64,"scores":{"party_welcome":0.0007147064316086471,"social_amenities":0.003715560771524906,"party_restriction":0.001097945962101221,"nearby_nightlife":0.9826734662055969}},{"text":"The neighborhood surrounding this condo is a captivating destination for guests seeking to experience the essence of Savannah's historic district. With cobblestone streets, well-preserved buildings, and picturesque squares adorned with moss-draped oak trees, you\u2019ll be immersed in Southern charm. Visit nearby museums like the Ships of the Sea Maritime Museum and the Telfair Museums, or take a leisurely stroll in Forsyth Park. The diverse culinary scene, featuring Southern specialties and international flavors, makes this area a food lover's paradise. *No parties or third party bookings* A rental agreement is required to be completed upon booking. Guest access We recommend parking in the Whitaker St.","section":"FULL DESCRIPTION","line":93,"scores":{"party_welcome":0.00028259665123187006,"social_amenities":0.0013835640856996179,"party_restriction":0.9983049631118774,"nearby_nightlife":0.9804897904396057}}]}}}],"complete":true},{"pin":"20004 13043","address":"165 W BAY ST #302W","permit_type":"non_owner","approved_guests":4.0,"advertised_guests":4.0,"neighbor_count":4,"counts":{"direct":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"neighbors":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0},"combined":{"All calls":0,"Noise-party-disturbance":0,"Parking complaints":0,"Noise complaints":0,"Loud party":0,"Disturbance / nuisance":0}},"calls":[],"listings":[{"listing_id":"565019960660932190","title":"Near River Street, City Market by Lucky Savannah","url":"https://www.airbnb.com/rooms/565019960660932190","guests":4.0,"permits":["SVR-02539"],"analysis":{"listing_id":"565019960660932190","signature":"c41e7bfe66511426b9668fb76bb28d71a4050df7940ce3d54627429b2874e490","source_sha256":"f79af4c9ad4e5d92d044a50ec082f0592ebe38cf012b89766c38e1f98156d0ac","chunks":7,"words":572,"party_signal":0,"social_signal":0.9